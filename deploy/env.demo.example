# Environment of the public demo (demo.reimbursebuddy.my.id).
# Copy to /etc/reimburse-buddy/demo.env, fill in the values, then:
#   chown root:root /etc/reimburse-buddy/demo.env && chmod 600 /etc/reimburse-buddy/demo.env
# Never commit the filled-in file. Lines starting with # are comments; no quotes around values.
# REIMBURSE_PLAN_STORE, REIMBURSE_WEB_UPLOADS and REIMBURSE_AGENT_LOG_DIR are set by the systemd unit.
# The demo uses its own Neon branch ("demo"), its own session key and its own LLM budget.

# --- Mode ---------------------------------------------------------------------------------------------
# APP_ENV stays unset: the profile picker is refused in production (ADR 0012).
# 1 turns /login into the passwordless profile picker and shows the demo banner on every page.
REIMBURSE_DEMO_PROFILES=1

# --- Databases (Neon branch "demo"; application role with a password different from production) -------
REIMBURSE_AUDIT_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB
# Optional. Accounts (app_users). Falls back to REIMBURSE_AUDIT_DATABASE_URL.
#REIMBURSE_AUTH_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB
# Optional. Plan state, claim state and checkpoints. Falls back to REIMBURSE_AUDIT_DATABASE_URL.
#REIMBURSE_STATE_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB
# Outside production the default is file; the demo keeps its state in Neon like the real app.
REIMBURSE_PLAN_BACKEND=postgres

# --- Login --------------------------------------------------------------------------------------------
# Own key, different from app.env. Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
REIMBURSE_DEMO_SESSION_KEY=CHANGE_ME_RANDOM_HEX

# --- LLM (claim agent) --------------------------------------------------------------------------------
# Provider key: DEEPSEEK_API_KEY or REIMBURSE_AGENT_API_KEY. Without it everything except the agent works.
REIMBURSE_AGENT_API_KEY=CHANGE_ME
REIMBURSE_AGENT_MODEL=deepseek-flash
REIMBURSE_AGENT_BASE_URL=https://api.deepseek.com
# REQUIRED here too: the demo is public, and outside production an unset budget means no cap at all.
# Keep it small. Prices are USD per million tokens, from the provider's pricing page at deploy time.
LLM_DAILY_BUDGET_USD=CHANGE_ME
LLM_PRICE_INPUT_MISS_PER_MTOK=CHANGE_ME
LLM_PRICE_INPUT_HIT_PER_MTOK=CHANGE_ME
LLM_PRICE_OUTPUT_PER_MTOK=CHANGE_ME
# Optional agent limits (defaults shown).
#REIMBURSE_AGENT_MAX_TOKENS=250000
#REIMBURSE_AGENT_RUN_DEADLINE=600
#REIMBURSE_AGENT_APPROVAL_DEADLINE=900
#REIMBURSE_INVESTIGATE_MAX_PER_MIN=3
#REIMBURSE_APPROVAL_DEADLINE_MIN=30

# --- Features and extraction --------------------------------------------------------------------------
REIMBURSE_EXTRACTOR=rapidocr
EMPLOYEE_QA=1
# Only for REIMBURSE_EXTRACTOR=vision, or dual with a vision model.
#VISION_API_BASE=
#VISION_MODEL=
#VISION_API_KEY=
