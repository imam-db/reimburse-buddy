# Reimburse Buddy: the public demo (profile picker, ADR 0012), port 8001.
# Installed by deploy/setup.sh to /etc/systemd/system/reimburse-demo.service (ADR 0013).
[Unit]
Description=Reimburse Buddy (demo)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=reimburse-demo
Group=reimburse-demo
WorkingDirectory=/opt/reimburse-buddy

# Secrets and per-instance settings live outside the repo: root-owned, mode 600.
EnvironmentFile=/etc/reimburse-buddy/demo.env

# Non-secret paths. Each instance has its own user and state root; nothing else is writable.
# uv never syncs or writes the root-owned virtualenvs (built by setup.sh as root).
Environment=HOME=/var/lib/reimburse-buddy/demo/home
Environment=UV_NO_SYNC=1
Environment=UV_PYTHON_INSTALL_DIR=/opt/uv-python
Environment=UV_CACHE_DIR=/var/lib/reimburse-buddy/demo/home/.cache/uv
Environment=FASTEMBED_CACHE_PATH=/var/lib/reimburse-buddy/demo/home/.cache/fastembed
Environment=REIMBURSE_PLAN_STORE=/var/lib/reimburse-buddy/demo/plans
Environment=REIMBURSE_WEB_UPLOADS=/var/lib/reimburse-buddy/demo/uploads
Environment=REIMBURSE_AGENT_LOG_DIR=/var/lib/reimburse-buddy/demo/agent-runs

# Listen on loopback only; Caddy is the public side.
ExecStart=/usr/local/bin/uv run --frozen --group rapidocr uvicorn --app-dir web reimburse_web.app:app --host 127.0.0.1 --port 8001
Restart=on-failure
RestartSec=5

# Basic hardening.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Only this instance's own state root is writable (code and virtualenvs are root-owned).
ReadWritePaths=/var/lib/reimburse-buddy/demo

[Install]
WantedBy=multi-user.target
